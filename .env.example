# NyxHive Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# Required: at least one LLM provider API key
# ============================================================

# Anthropic (Claude) - for claude-* models
ANTHROPIC_API_KEY=fake-anthropic-key

# OpenRouter - for google/*, qwen/*, xiaomi/* models
OPENROUTER_API_KEY=fake-openrouter-key

# MiniMax - for MiniMax-M2.5
MINIMAX_API_KEY=...
MINIMAX_GROUP_ID=...

# ============================================================
# Optional: channel tokens (enable the channels you use)
# ============================================================

# Discord bot token
DISCORD_TOKEN=...

# Slack Bot User OAuth Token + Signing Secret + App Token (Socket Mode)
SLACK_BOT_TOKEN=fake-slack-bot-token
SLACK_SIGNING_SECRET=fake-slack-signing-secret
SLACK_APP_TOKEN=fake-slack-app-token

# Telegram bot token
TELEGRAM_TOKEN=...

# ============================================================
# Optional: server & security
# ============================================================

# API authentication key (leave empty to allow unauthenticated access on localhost)
# Set this when exposing the API to a network
NYXHIVE_API_KEY=...

# Allow unauthenticated API access (set to "true" only for local development)
NYXHIVE_INSECURE=false

# Server port (default: 3777)
NYX_PORT=3777

# ============================================================
# Optional: data directory (default: ~/.nyxhive)
# ============================================================
NYXHIVE_DATA_DIR=~/.nyxhive

# ============================================================
# Optional: APNs push notifications for iOS
# ============================================================
# APNS_KEY_ID=...
# APNS_TEAM_ID=...
# APNS_KEY_PATH=./path/to/AuthKey_KEYID.p8
# APNS_BUNDLE_ID=com.yourcompany.nyxai
# APNS_PRODUCTION=false
